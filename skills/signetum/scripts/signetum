#!/bin/sh
set -eu
skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
data_home=${XDG_DATA_HOME:-}
if [ -z "$data_home" ]; then
    data_home="$HOME/.local/share"
fi
bootstrap="$data_home/signetum/runtime/host-python"
if [ "${1:-}" = setup ]; then
    exec mise exec python@3.12 uv@0.12.2 -- python -B "$skill_dir/scripts/launch.py" "$@"
fi
if [ ! -x "$bootstrap" ]; then
    printf '%s\n' '{"status":"failed","stage":"skill-execution","cause":"Skill environment is not prepared; run the explicit setup command first"}' >&2
    exit 2
fi
case "${1:-}" in
    install | update) exec "$bootstrap" -B "$skill_dir/scripts/distribution.py" "$@" ;;
esac
exec "$bootstrap" -B "$skill_dir/scripts/launch.py" "$@"
