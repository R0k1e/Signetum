#!/bin/sh
set -eu
skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${1:-}" = setup ] || [ "${1:-}" = update ]; then
    exec mise exec python@3.12 -- python "$skill_dir/scripts/launch.py" "$@"
fi
if [ ! -x "$skill_dir/.runtime/host-python" ]; then
    printf '%s\n' '{"status":"failed","stage":"skill-execution","cause":"Skill environment is not prepared; run the explicit setup command first"}' >&2
    exit 2
fi
exec "$skill_dir/.runtime/host-python" "$skill_dir/scripts/launch.py" "$@"
