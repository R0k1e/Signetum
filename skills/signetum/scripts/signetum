#!/bin/sh
set -eu
skill_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${1:-}" = update ]; then
    case "$#:${2:-}" in
        1:|2:--help)
            printf '%s\n' '{"schema_version":1,"operation":"update","status":"instructions","reference":"references/adoption.md","automatic_updates":false}'
            exit 0
            ;;
        *)
            if [ ! -x "$skill_dir/.runtime/host-python" ]; then
                printf '%s\n' '{"status":"failed","cause":"Prepare the Skill with setup before checking or executing updates"}' >&2
                exit 2
            fi
            shift
            exec "$skill_dir/.runtime/host-python" "$skill_dir/scripts/update.py" "$@"
            ;;
    esac
fi
if [ "${1:-}" = setup ]; then
    exec mise exec python@3.12 -- python "$skill_dir/scripts/launch.py" "$@"
fi
if [ ! -x "$skill_dir/.runtime/host-python" ]; then
    printf '%s\n' '{"status":"failed","stage":"skill-execution","cause":"Skill environment is not prepared; run the explicit setup command first"}' >&2
    exit 2
fi
exec "$skill_dir/.runtime/host-python" "$skill_dir/scripts/launch.py" "$@"
