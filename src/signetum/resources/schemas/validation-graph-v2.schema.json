{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signetum.invalid/schemas/validation-graph-v2.schema.json",
  "title": "Signetum validation graph v2 contribution",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "identity_command"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "identity_command": {"$ref": "#/$defs/argv"}
        }
      }
    },
    "shards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command"],
        "properties": {
          "name": {"$ref": "#/$defs/namespacedName"},
          "command": {"$ref": "#/$defs/argv"},
          "requires": {
            "type": "array",
            "items": {"$ref": "#/$defs/namespacedName"},
            "uniqueItems": true
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "shards"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
          "shards": {
            "type": "array",
            "items": {"$ref": "#/$defs/namespacedName"},
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "namespacedName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.@-]*(?::[a-z][a-z0-9_.@-]*)+$"
    }
  }
}
