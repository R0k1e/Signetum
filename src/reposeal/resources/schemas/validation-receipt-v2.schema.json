{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reposeal.invalid/schemas/validation-receipt-v2.schema.json",
  "title": "RepoSeal validation receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "identity", "executed_gates", "executed_shards", "valid"],
  "properties": {
    "schema_version": {"const": 2},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "configuration", "profiles", "graph", "lockfiles", "tools"],
      "properties": {
        "commit": {"$ref": "#/$defs/gitIdentity"},
        "tree": {"$ref": "#/$defs/gitIdentity"},
        "configuration": {"$ref": "#/$defs/artifact"},
        "profiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "graph": {"$ref": "#/$defs/digest"},
        "lockfiles": {"type": "array", "items": {"$ref": "#/$defs/artifact"}, "uniqueItems": true},
        "tools": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "identity"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "identity": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "executed_gates": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "executed_shards": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "valid": {"const": true}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitIdentity": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "digest"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/$defs/digest"}
      }
    }
  }
}
