{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-signetum.invalid/schemas/review/v1",
  "title": "Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "recorded_at", "source", "clauses"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "active", "closed"]},
    "recorded_at": {"type": "string", "format": "date"},
    "source": {"type": "object"},
    "clauses": {"type": "array", "minItems": 1},
    "exclusions": {"type": "array"},
    "acceptances": {"type": "array"},
    "reopenings": {"type": "array"}
  }
}
