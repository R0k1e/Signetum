{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://development-foundation.invalid/schemas/plan/v1",
  "title": "Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "specification", "approved_base", "obligations"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "approved"]},
    "specification": {"type": "string", "minLength": 1},
    "approved_base": {"type": "string", "minLength": 1},
    "obligations": {"type": "array", "minItems": 1}
  }
}
