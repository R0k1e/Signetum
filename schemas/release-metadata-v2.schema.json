{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/R0k1e/Signetum/main/schemas/release-metadata-v2.schema.json",
  "title": "Signetum release metadata v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "components"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "digest"
        ],
        "properties": {
          "name": {
            "enum": [
              "package",
              "schemas",
              "signetum-skill"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "name": {
                "const": "package"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "schemas"
              }
            }
          }
        },
        {
          "contains": {
            "properties": {
              "name": {
                "const": "signetum-skill"
              }
            }
          }
        }
      ]
    }
  }
}
